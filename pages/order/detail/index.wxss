.status {
  position: relative;
  padding: 48rpx 40rpx 56rpx;
  background: var(--ink-1);
  color: #fff;
}

.status::before {
  content: "";
  position: absolute;
  left: 0;
  top: 52rpx;
  width: 8rpx;
  height: 64rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--figma-orange);
}

.status--receiving::before {
  background: var(--figma-blue);
}

.status--done::before {
  background: var(--figma-green);
}

.status--canceled::before {
  background: var(--ink-4);
}

.status__text {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
}

.status__desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

.panel {
  margin: 24rpx;
  padding: 28rpx;
}

.panel__title {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 时间轴 */
.timeline__item {
  position: relative;
  display: flex;
  padding-bottom: 28rpx;
}

.timeline__item:last-child {
  padding-bottom: 0;
}

.timeline__dot {
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 20rpx 0 0;
  border-radius: 50%;
  background: var(--line-1);
  flex: none;
  z-index: 1;
}

.timeline__item.is-latest .timeline__dot {
  background: var(--ink-1);
}

.timeline__line {
  position: absolute;
  left: 6rpx;
  top: 20rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line-1);
}

.timeline__content {
  flex: 1;
}

.timeline__text {
  color: var(--ink-3);
  font-size: 25rpx;
  line-height: 1.4;
}

.timeline__item.is-latest .timeline__text {
  color: var(--ink-1);
  font-weight: 600;
}

.timeline__time {
  margin-top: 6rpx;
  color: var(--ink-4);
  font-size: 22rpx;
}

/* 收货信息 */
.addr {
  display: flex;
}

.addr__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex: none;
}

.addr__person {
  font-size: 27rpx;
  font-weight: 600;
}

.addr__detail {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 商品 */
.goods__item {
  display: flex;
  padding: 14rpx 0;
}

.goods__media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--r-sm);
  flex: none;
}

.goods__emoji {
  font-size: 58rpx;
}

.goods__info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.goods__title {
  font-size: 27rpx;
  font-weight: 600;
}

.goods__spec {
  margin-top: 8rpx;
  color: var(--ink-4);
  font-size: 22rpx;
}

.goods__price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods__price {
  font-size: 27rpx;
}

.goods__qty {
  margin-top: 6rpx;
  color: var(--ink-4);
  font-size: 22rpx;
}

/* 金额与订单信息 */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.amount-red {
  color: var(--promo);
}

.amount-row--total {
  color: var(--ink-1);
  font-weight: 600;
}

.amount-total {
  color: var(--ink-1);
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 25rpx;
}

.info-row__label {
  color: var(--ink-4);
}

.info-row__value {
  max-width: 70%;
  text-align: right;
  color: var(--ink-1);
}

.info-row__copy {
  margin-left: 12rpx;
  color: var(--link);
}

.detail__placeholder {
  height: 160rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 120rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid var(--line-1);
}

.action-bar__btn {
  min-width: 170rpx;
  height: 72rpx;
  margin-left: 16rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-sm);
  color: var(--ink-2);
  font-size: 26rpx;
}

.action-bar__btn--primary {
  border-color: var(--ink-1);
  background: var(--ink-1);
  color: #fff;
}
