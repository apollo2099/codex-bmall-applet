<view class="page" wx:if="{{order}}">
  <!-- 状态头 -->
  <view class="status status--{{order.status}}">
    <view class="status__text">{{order.statusText}}</view>
    <view class="status__desc">{{statusDesc}}</view>
  </view>

  <!-- 物流时间轴 -->
  <view class="card panel" wx:if="{{timeline.length}}">
    <view class="panel__title">物流跟踪</view>
    <view class="timeline">
      <view class="timeline__item {{index === 0 ? 'is-latest' : ''}}" wx:for="{{timeline}}" wx:key="time">
        <view class="timeline__dot"></view>
        <view class="timeline__line" wx:if="{{index !== timeline.length - 1}}"></view>
        <view class="timeline__content">
          <view class="timeline__text">{{item.text}}</view>
          <view class="timeline__time">{{item.timeText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="card panel" wx:if="{{order.address}}">
    <view class="panel__title">收货信息</view>
    <view class="addr">
      <view class="icon icon--location addr__icon"></view>
      <view class="addr__info">
        <view class="addr__person">{{order.address.name}} {{order.address.phone}}</view>
        <view class="addr__detail">
          {{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}
        </view>
      </view>
    </view>
  </view>

  <!-- 商品 -->
  <view class="card panel">
    <view class="panel__title">商品信息</view>
    <view class="goods__item" wx:for="{{order.goods}}" wx:key="goodsId">
      <view class="goods__media" style="background: {{item.tint}}">
        <text class="goods__emoji">{{item.emoji}}</text>
      </view>
      <view class="goods__info">
        <view class="goods__title ellipsis-2">{{item.title}}</view>
        <view class="goods__spec">{{item.spec}}</view>
      </view>
      <view class="goods__price-col">
        <text class="goods__price">¥{{item.price}}</text>
        <text class="goods__qty">×{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 金额 -->
  <view class="card panel">
    <view class="amount-row">
      <text>商品金额</text>
      <text>¥{{order.goodsAmount}}</text>
    </view>
    <view class="amount-row">
      <text>运费</text>
      <text>{{order.freight === '0.00' ? '包邮' : '¥' + order.freight}}</text>
    </view>
    <view class="amount-row">
      <text>优惠</text>
      <text class="amount-red">-¥{{order.discount}}</text>
    </view>
    <view class="divider"></view>
    <view class="amount-row amount-row--total">
      <text>实付金额</text>
      <text class="amount-total">¥{{order.payAmount}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card panel">
    <view class="panel__title">订单信息</view>
    <view class="info-row">
      <text class="info-row__label">订单编号</text>
      <view class="info-row__value" bindtap="onCopyOrderNo">
        {{order.orderNo}}<text class="info-row__copy">复制</text>
      </view>
    </view>
    <view class="info-row">
      <text class="info-row__label">下单时间</text>
      <text class="info-row__value">{{createTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-row__label">支付时间</text>
      <text class="info-row__value">{{payTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-row__label">支付方式</text>
      <text class="info-row__value">{{order.payMethod}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-row__label">订单备注</text>
      <text class="info-row__value">{{order.remark}}</text>
    </view>
  </view>

  <view class="detail__placeholder"></view>

  <!-- 底部操作 -->
  <view class="action-bar">
    <view class="action-bar__btn" bindtap="onService">联系客服</view>
    <block wx:if="{{order.status === 'pending'}}">
      <view class="action-bar__btn" bindtap="onCancel">取消订单</view>
      <view class="action-bar__btn action-bar__btn--primary" bindtap="onPay">立即支付</view>
    </block>
    <block wx:elif="{{order.status === 'receiving'}}">
      <view class="action-bar__btn action-bar__btn--primary" bindtap="onConfirmReceive">确认收货</view>
    </block>
    <block wx:else>
      <view class="action-bar__btn" bindtap="onDelete">删除订单</view>
      <view class="action-bar__btn action-bar__btn--primary" bindtap="onRebuy">再次购买</view>
    </block>
  </view>
</view>

<view class="loading-text" wx:else>订单加载中…</view>
