.cart-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.topbar__count {
  color: var(--ink-3);
  font-size: 26rpx;
}

.topbar__edit {
  color: var(--link);
  font-size: 26rpx;
}

.cart-list {
  padding: 16rpx 24rpx 0;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-xs);
  background: #fff;
  color: #fff;
  font-size: 24rpx;
  flex: none;
}

.checkbox.is-checked {
  background: var(--ink-1);
  border-color: var(--ink-1);
}

.cart-item__media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 170rpx;
  height: 170rpx;
  border-radius: var(--r-sm);
  flex: none;
  overflow: hidden;
}

.cart-item__img {
  width: 100%;
  height: 100%;
}

.cart-item__emoji {
  font-size: 68rpx;
}

.cart-item__info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.cart-item__title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}

.cart-item__spec {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-pill);
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 20rpx;
}

.cart-item__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.cart-item__price {
  display: flex;
  align-items: baseline;
  color: var(--ink-1);
  font-weight: 600;
}

.cart-item__price-num {
  font-size: 32rpx;
}

.cart-item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.cart-item__subtotal {
  color: var(--ink-4);
  font-size: 22rpx;
}

.cart-item__delete {
  color: var(--ink-3);
  font-size: 22rpx;
}

.recommend {
  margin-top: 40rpx;
}

.recommend__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recommend__item {
  width: 48.5%;
  margin-bottom: 20rpx;
}

.settle {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--line-1);
  box-shadow: var(--shadow-bar);
}

.settle__all {
  display: flex;
  align-items: center;
}

.settle__all-text {
  color: var(--ink-2);
  font-size: 26rpx;
}

.settle__amount {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding-right: 20rpx;
}

.settle__label {
  margin-right: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.settle__symbol {
  color: var(--ink-1);
  font-size: 24rpx;
}

.settle__number {
  color: var(--ink-1);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.settle__btn {
  flex: none;
  min-width: 220rpx;
  height: 80rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
  background: var(--ink-1);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.settle__btn.disabled {
  background: var(--line-1);
  color: var(--ink-4);
}

.settle__btn--danger {
  background: #fff;
  border: 1rpx solid var(--line-1);
  color: var(--ink-1);
}
