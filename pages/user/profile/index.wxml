<view class="page" wx:if="{{user}}">
  <view class="card section panel">
    <view class="panel__title">选择头像</view>
    <view class="avatar-grid">
      <view
        class="avatar-grid__item {{avatarEmoji === item ? 'is-active' : ''}}"
        wx:for="{{avatars}}"
        wx:key="*this"
        data-emoji="{{item}}"
        bindtap="onAvatarTap"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="card section panel">
    <view class="field">
      <text class="field__label">昵称</text>
      <input class="field__input" placeholder="请输入昵称" value="{{nickname}}" maxlength="16" bindinput="onNicknameInput" />
    </view>
    <view class="field">
      <text class="field__label">手机号</text>
      <input class="field__input" placeholder="请输入手机号" value="{{phone}}" maxlength="13" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <text class="field__label">会员等级</text>
      <text class="field__value">{{user.level}}</text>
    </view>
    <view class="field">
      <text class="field__label">用户 ID</text>
      <text class="field__value">{{user.id}}</text>
    </view>
  </view>

  <view class="section">
    <view class="btn-primary {{saving ? 'disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存资料'}}
    </view>
  </view>
</view>

<view class="loading-text" wx:else>加载中…</view>
