.header {
  padding: 24rpx 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line-1);
}

.header__brand {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.header__brand-text {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.header__bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-sm);
  background: var(--surface-2);
}

.header__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.header__placeholder {
  color: var(--ink-4);
  font-size: 26rpx;
}

.header__tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.header__tag {
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(242, 78, 30, 0.24);
  border-radius: var(--r-pill);
  background: #fef1ec;
  color: var(--promo);
  font-size: 20rpx;
}

.header__sub {
  color: var(--ink-3);
  font-size: 22rpx;
}

/* 轮播：墨黑底 + 品牌强调条 */
.banner {
  height: 280rpx;
  margin: 24rpx 24rpx 0;
  border-radius: var(--r-md);
  overflow: hidden;
}

.banner__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 40rpx;
  border-radius: var(--r-md);
}

.banner__accent {
  position: absolute;
  left: 0;
  top: 48rpx;
  width: 8rpx;
  height: 64rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.banner__title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.banner__subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}

.banner__btn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: var(--r-sm);
  color: #fff;
  font-size: 22rpx;
}

.banner__glyph {
  width: 128rpx;
  height: 128rpx;
  opacity: 0.92;
}

/* 分类金刚区 */
.grid-section {
  padding: 28rpx 8rpx 6rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.grid__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-md);
}

.grid__glyph {
  width: 44rpx;
  height: 44rpx;
}

.grid__name {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.grid__dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.grid__text {
  color: var(--ink-2);
  font-size: 22rpx;
}

/* 热销榜 */
.hot {
  white-space: nowrap;
  width: 100%;
}

.hot__item {
  display: inline-block;
  width: 240rpx;
  margin-right: 20rpx;
  padding: 16rpx;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-md);
  background: #fff;
  vertical-align: top;
}

.hot__media {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 190rpx;
  border-radius: var(--r-sm);
}

.hot__emoji {
  font-size: 76rpx;
}

.hot__rank {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: rgba(30, 30, 30, 0.86);
  color: #fff;
  font-size: 18rpx;
}

.hot__title {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.hot__price {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  color: var(--ink-1);
  font-weight: 600;
}

.hot__price-num {
  font-size: 32rpx;
}

.hot__sales {
  color: var(--ink-4);
  font-size: 20rpx;
}

/* 猜你喜欢 */
.feed {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feed__item {
  width: 48.5%;
  margin-bottom: 22rpx;
}
