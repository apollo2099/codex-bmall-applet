/**
 * 线性图标系统
 * 统一 24×24 网格、1.7 描边、圆角端点，颜色统一为 --icon-base(#8a8a8a)，
 * 选中态通过 filter: brightness(0) 转为墨黑，避免维护多套颜色资源。
 */
.icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* 选中 / 强调：转为墨黑 */
.icon.is-active,
.icon--ink {
  filter: brightness(0);
}

.icon--mute {
  opacity: 0.55;
}

/* 深色底上的白色图标 */
.icon--on-dark {
  filter: brightness(0) invert(1);
}

