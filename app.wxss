@import "styles/icons.wxss";

/**
 * 全局设计系统 · Figma 风格
 * 参考 Figma 品牌与产品界面语言：中性画布 + 1px 描边 + 墨黑主色，
 * 品牌色（橙/珊瑚/紫/蓝/绿）只用于强调，不使用大面积渐变。
 */
page {
  /* Figma 品牌色 */
  --figma-orange: #f24e1e;
  --figma-coral: #ff7262;
  --figma-purple: #a259ff;
  --figma-blue: #1abcfe;
  --figma-green: #0acf83;

  /* 中性色阶 */
  --ink-1: #1e1e1e;
  --ink-2: #4a4a4a;
  --ink-3: #757575;
  --ink-4: #b3b3b3;
  --line-1: #e6e6e6;
  --line-2: #f0f0f0;
  --surface-1: #ffffff;
  --surface-2: #fafafa;
  --canvas: #f5f5f5;

  /* 语义色 */
  --primary: #1e1e1e;
  --link: #0d99ff;
  --price: #1e1e1e;
  --promo: #f24e1e;
  --success: #0acf83;

  /* 圆角 */
  --r-xs: 8rpx;
  --r-sm: 12rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-pill: 999rpx;

  /* 间距 */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;
  --sp-6: 48rpx;

  /* 阴影：只在浮层与固定栏使用 */
  --shadow-bar: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-pop: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);

  background-color: var(--canvas);
  color: var(--ink-1);
  font-family: "Inter", -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
scroll-view,
swiper,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

image {
  display: block;
}

.page {
  min-height: 100vh;
  padding-bottom: var(--sp-4);
}

.page-with-bar {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 卡片：白底 + 细描边，不使用重投影 */
.card {
  background: var(--surface-1);
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-md);
}

.section {
  margin: var(--sp-3);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-3);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--link);
}

/* 小号标签字，用于分组说明 */
.eyebrow {
  color: var(--ink-4);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* Figma 品牌色点，作为视觉签名 */
.brand-dots {
  display: flex;
  align-items: center;
}

.brand-dots .dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 6rpx;
  border-radius: 50%;
}

.dot--orange { background: var(--figma-orange); }
.dot--coral { background: var(--figma-coral); }
.dot--purple { background: var(--figma-purple); }
.dot--blue { background: var(--figma-blue); }
.dot--green { background: var(--figma-green); }

/* 价格 */
.price {
  color: var(--price);
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.price-symbol {
  margin-right: 2rpx;
  font-size: 22rpx;
}

.price-origin {
  margin-left: 12rpx;
  color: var(--ink-4);
  font-size: 22rpx;
  text-decoration: line-through;
}

/* 按钮：主按钮为墨黑实心，次按钮为白底描边 */
.btn-primary,
.btn-plain,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-sm);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-primary.disabled {
  background: var(--line-1);
  color: var(--ink-4);
}

.btn-plain {
  background: var(--surface-1);
  border: 1rpx solid var(--line-1);
  color: var(--ink-1);
}

.btn-ghost {
  background: transparent;
  color: var(--link);
}

/* 标签：胶囊描边样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  margin-right: 10rpx;
  border: 1rpx solid var(--line-1);
  border-radius: var(--r-pill);
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 20rpx;
}

.tag--accent {
  border-color: rgba(242, 78, 30, 0.24);
  background: #fef1ec;
  color: var(--promo);
}

.tag--link {
  border-color: rgba(13, 153, 255, 0.24);
  background: #eaf6ff;
  color: var(--link);
}

/* 列表项 */
.cell {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 0 var(--sp-3);
  background: var(--surface-1);
}

.cell + .cell {
  border-top: 1rpx solid var(--line-2);
}

.cell__label {
  flex: 1;
  font-size: 28rpx;
}

.cell__value {
  color: var(--ink-3);
  font-size: 26rpx;
}

.arrow::after {
  content: "";
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-top: 2rpx solid var(--ink-4);
  border-right: 2rpx solid var(--ink-4);
  transform: rotate(45deg);
}

.divider {
  height: 1rpx;
  background: var(--line-1);
  margin: var(--sp-3) 0;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.loading-text {
  padding: var(--sp-4) 0;
  text-align: center;
  color: var(--ink-4);
  font-size: 24rpx;
}
