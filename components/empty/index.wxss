.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty__figure {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--surface-2, #fafafa);
  border: 1rpx solid var(--line-1, #e6e6e6);
}

.empty__icon {
  width: 64rpx;
  height: 64rpx;
}

.empty__emoji {
  font-size: 72rpx;
}

.empty__title {
  margin-top: 28rpx;
  color: var(--ink-1, #1e1e1e);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.empty__desc {
  margin-top: 10rpx;
  color: var(--ink-3, #757575);
  font-size: 24rpx;
  text-align: center;
}

.empty__btn {
  width: 280rpx;
  margin-top: 40rpx;
}
